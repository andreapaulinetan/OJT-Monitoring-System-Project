<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    
    <display-name>InternshipLearningTracker</display-name>

    <!-- Embedded Apache Derby (Authentication) Context Parameters -->
    <context-param>
        <param-name>derby.driver</param-name>
        <param-value>org.apache.derby.jdbc.ClientDriver</param-value>
    </context-param>
    <context-param>
        <param-name>derby.url</param-name>
        <param-value>jdbc:derby://localhost:1527/C:/Users/Sean/OneDrive/Documents/NetBeansProjects/OJT-Monitoring-System-Project/database/ojt_AuthenticationDB</param-value>
    </context-param>
    <context-param>
        <param-name>derby.username</param-name>
        <param-value>app</param-value>
    </context-param>
    <context-param>
        <param-name>derby.password</param-name>
        <param-value>app</param-value>
    </context-param>

    <!-- MySQL (Operational Monitoring Data) Context Parameters -->
    <context-param>
        <param-name>mysql.driver</param-name>
        <param-value>com.mysql.cj.jdbc.Driver</param-value>
    </context-param>
    <context-param>
        <param-name>mysql.url</param-name>
        <param-value>jdbc:mysql://localhost:3306/ojt_monitoringdb</param-value>
    </context-param>
    <context-param>
        <param-name>mysql.username</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>mysql.password</param-name>
        <param-value></param-value> 
    </context-param>

    <!-- PostgreSQL (Security Audit Log) Context Parameters -->
    <context-param>
        <param-name>pgsql.driver</param-name>
        <param-value>org.postgresql.Driver</param-value>
    </context-param>
    <context-param>
        <param-name>pgsql.url</param-name>
        <param-value>jdbc:postgresql://localhost:5432/auditdb</param-value>
    </context-param>
    <context-param>
        <param-name>pgsql.username</param-name>
        <param-value>postgres</param-value>
    </context-param>
    <context-param>
        <param-name>pgsql.password</param-name>
        <param-value>110705</param-value>
    </context-param>

    <!-- Reporting Engine Branding Strings -->
    <context-param>
        <param-name>report.header</param-name>
        <param-value>Active Learning, Inc. — Internship Learning Tracker</param-value>
    </context-param>
    <context-param>
        <param-name>report.footer</param-name>
        <param-value>Confidential | Generated by ICS2609 System</param-value>
    </context-param>

    <!-- Security Filters -->
    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>util.SecurityFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>controller.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Servlet Declarations -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddInternServlet</servlet-name>
        <servlet-class>controller.AddInternServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CaptchaServlet</servlet-name>
        <servlet-class>controller.CaptchaServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>controller.ReportServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AuditServlet</servlet-name>
        <servlet-class>controller.AuditServlet</servlet-class>
    </servlet>


    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddInternServlet</servlet-name>
        <url-pattern>/AddInternServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CaptchaServlet</servlet-name>
        <url-pattern>/CaptchaServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/ReportServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuditServlet</servlet-name>
        <url-pattern>/AuditServlet</url-pattern>
    </servlet-mapping>


    <!-- Session Management Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Default Entry Route -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- HTTP Error Status Route Target Mappings -->
    <error-page>
        <error-code>400</error-code>
        <location>/error_400.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/error_403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error_404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error_500.jsp</location>
    </error-page>
    <!-- Force webapp reload after fixing DB SSL connection parameter: 2026-05-22T12:44:35 -->
</web-app>